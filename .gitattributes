# run `git add --renormalize .` after change this file
# see https://www.git-scm.com/docs/gitattributes
*.sh	text eol=lf
*.bat	text eol=crlf
*.ini	text working-tree-encoding=UTF-16LE-BOM eol=CRLF

# Vendored web assets: kept byte-identical to upstream so the recorded
# SHA-256 in src/webview2-assets/README-vendored.md stays verifiable.
src/webview2-assets/mermaid.min.js	-text

# Line-ending test samples must stay byte-exact.
tests/markdown-preview/samples/constructs-crlf.md	-text
tests/markdown-preview/samples/constructs-cr.md	-text
